---
import {Picture} from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';

interface Props {
    date: Date;
    title: string;
    image: ImageMetadata;
    imageAttribution?: string;
    lang: 'de' | 'en';
    pageBody: string;
}

const {date, title, image, imageAttribution, lang, pageBody} = Astro.props;
const formattedDate = date.toLocaleString(lang, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
});

const pageDescription = pageBody.slice(0, 200) + '…';
---

<style>
    div :global(a) {
        color: var(--color-main-green);
    }
    div :global(a:hover) {
        text-decoration: underline;
    }
    div :global(h2) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        font-size: 1.5rem;
        font-weight: semibold;
    }
    div :global(h3) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        font-size: 1.25rem;
        font-weight: semibold;
    }
    div :global(h4) {
        margin-top: 1rem;
        margin-bottom: 1rem;
        font-size: 1.125rem;
        font-weight: semibold;
    }
    div :global(ul) {
        list-style-type: disc;
        padding-left: 1.5rem;
    }
    div :global(ol) {
        list-style-type: decimal;
        padding-left: 1.5rem;
    }
    div :global(blockquote) {
        margin: 1.5rem 0;
        padding: 0.75rem 1rem 0.75rem 1.25rem;
        border-left: 4px solid var(--color-main-green);
        border-radius: 0.5rem;
        background: color-mix(in srgb, var(--color-main-green) 12%, white);
        color: color-mix(in srgb, var(--color-main-green) 12%, black);
        font-style: italic;
    }
    div :global(pre) {
        padding: 1rem;
    }
</style>

<Layout title={title} description={pageDescription}>
    <Section>
        <div class="mx-auto w-full text-justify">
            <div class="relative">
                <Picture class="w-full rounded-xl object-cover" src={image} alt={title} />
                {
                    imageAttribution && (
                        <p class="absolute right-3 bottom-3 rounded-md bg-black/65 px-2 py-1 text-xs text-white backdrop-blur-sm">
                            {imageAttribution}
                        </p>
                    )
                }
            </div>
            <p class="my-8 text-xs text-gray-500 dark:text-neutral-500">
                {formattedDate}
            </p>
            <div class="space-y-4 text-base">
                <slot />
            </div>
        </div>
    </Section>
</Layout>
